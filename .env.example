# ------------------------------------------------------------------------------
# Local development template. Copy to .env, then run `php artisan key:generate`.
#
# PLACEHOLDERS ONLY. Never commit a real secret to this file — it is tracked in
# git, so anything written here is published to everyone who ever clones the
# repository, and stays in the history after it is deleted.
# For production values see .env.production.example.
# ------------------------------------------------------------------------------

APP_NAME=ProCTAD
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=proctad_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_PREFIX=proctad_

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Leave false locally (there is no TLS on 127.0.0.1); true in production.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Obtain from Google Cloud Console. Never commit the real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Reverse proxy in front of the app. Empty locally — there is none. See
# config/security.php for why leaving this unset behind a load balancer
# silently breaks rate limiting and the audit trail's IP addresses.
TRUSTED_PROXIES=
# Host allow-list for absolute URLs (password reset links above all).
# Empty disables the check; acceptable locally, never in production.
TRUSTED_HOSTS=
# Report CSP violations without enforcing. Start true after any policy change.
CSP_REPORT_ONLY=false

VITE_APP_NAME="${APP_NAME}"

# For mobile/local network access — replace with your actual IP
VITE_DEV_SERVER_URL=http://10.53.1.149:5173
