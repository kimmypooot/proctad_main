# ------------------------------------------------------------------------------
# Production template for the ProCTAD live host.
#
# PLACEHOLDERS ONLY — fill these in on the server, never in the repository.
# After editing, run `php artisan proctad:preflight`; it fails the deployment
# on the settings below that are dangerous rather than merely wrong.
# ------------------------------------------------------------------------------

APP_NAME=ProCTAD
APP_ENV=production
# php artisan key:generate --force
# Signs every signed URL and encrypts members' dates of birth. Rotating it
# invalidates both, so plan a re-encryption before changing it on live data.
APP_KEY=
APP_DEBUG=false
APP_URL=https://proctad.csc.gov.ph

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# 12 is the Laravel default and the floor. Raise to 13 if the host has the
# CPU headroom; measure sign-in latency before and after.
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# NOT debug. Debug-level records request context that includes PII.
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=proctad_db
# A least-privilege account: SELECT/INSERT/UPDATE/DELETE on this schema only.
# Not root, and with no GRANT, DROP or FILE.
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_PREFIX=proctad_
# Path to the CA bundle, if the database is on another host.
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

SESSION_DRIVER=database
# 30 minutes idle. The console reaches the whole regional member registry;
# 120 is a long time for an unattended office machine.
SESSION_LIFETIME=30
# Session payloads hold flashed data and the resolved-assignment list.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=proctad.csc.gov.ph
# Required. Without it the session cookie travels over plain HTTP on any
# downgrade — a link, a captive portal, an SSL-stripping proxy at a venue.
SESSION_SECURE_COOKIE=true
# 'strict' is preferable; use 'lax' if the Google OAuth return breaks under it.
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="proctad@csc.gov.ph"
MAIL_FROM_NAME="${APP_NAME}"

# Rotate these if they have ever appeared in the repository or in a chat.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# The load balancer / reverse proxy address or CIDR, comma-separated.
# Until this is set, $request->secure() reads false behind TLS termination,
# the Secure cookie flag and HSTS are suppressed, every rate limiter shares
# one bucket, and audit_logs records the proxy instead of the actor.
# Use '*' only if the app is unreachable except through the proxy.
TRUSTED_PROXIES=
# Every hostname the app answers on. An unchecked Host header lets an attacker
# have a password reset link delivered to a domain they control.
TRUSTED_HOSTS=proctad.csc.gov.ph
# Enforce the CSP only after watching one full exam cycle in report-only mode.
CSP_REPORT_ONLY=true

VITE_APP_NAME="${APP_NAME}"
